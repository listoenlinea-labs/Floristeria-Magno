NODE_ENV=development
PORT=3000

DB_HOST=servidor_mysql
DB_PORT=3306
DB_NAME=nombre_base_datos
DB_USER=usuario_base_datos
DB_PASSWORD=contraseña_base_datos
DB_SSL=false

FRONTEND_URL=http://127.0.0.1:5500
FRONTEND_URL_WWW=http://localhost:5500

JWT_SECRET=coloca_un_secreto_largo_y_aleatorio|

# ============================================================
# MERCADO PAGO Y CORREO DE CONFIRMACIÓN
# ============================================================
MP_ACCESS_TOKEN=APP_USR-...
MP_WEBHOOK_SECRET=...
FRONTEND_PUBLIC_URL=https://tudominio.com
PUBLIC_API_URL=https://api.tudominio.com
DELIVERY_COST=120

SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=usuario_smtp
SMTP_PASSWORD=contraseña_smtp
EMAIL_FROM=pedidos@tudominio.com

# ============================================================
# WHATSAPP CLOUD API (CONFIRMACIÓN DE PEDIDOS)
# ============================================================
# La plantilla debe ser de tipo Utility, estar aprobada por Meta y
# contener ocho variables en este orden:
# {{1}} nombre, {{2}} código, {{3}} productos, {{4}} total,
# {{5}} fecha, {{6}} horario, {{7}} dirección, {{8}} URL de rastreo.
WHATSAPP_ACCESS_TOKEN=...
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_ORDER_TEMPLATE_NAME=pedido_confirmado
WHATSAPP_TEMPLATE_LANGUAGE=es_MX
WHATSAPP_GRAPH_API_VERSION=v24.0

# ============================================================
# IMÁGENES PERSISTENTES
# ============================================================
# En producción se recomienda definir IMAGE_STORAGE_ROOT fuera
# de la carpeta desplegada por Node. Si se omite, la aplicación
# usará $HOME/floristeria-magno-data automáticamente.
#
# IMAGE_STORAGE_ROOT=/home/tu_usuario/floristeria-magno-data
#
# Opcional: rutas explícitas para almacenamiento principal y backup.
# UPLOADS_DIR=/home/tu_usuario/floristeria-magno-data/uploads
# UPLOADS_BACKUP_DIR=/home/tu_usuario/floristeria-magno-data/uploads-backup
#
# URL pública estable del backend. Evita guardar URLs con hosts
# temporales o diferentes según el proxy.
# PUBLIC_API_URL=https://api.listoenlinea.host
